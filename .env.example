# Frog Bot needs exactly one thing from you: an AI API key (Claude or OpenAI).
#
# The easiest way is to paste it into the app on first launch: it is then
# stored encrypted with your OS keychain. Developers can instead copy this
# file to `.env` and fill it in. `.env` is git-ignored and never committed.
# Every value below is a placeholder.

# Claude (recommended): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-claude-api-key-here
# Or keep the key in its own file and point to it:
# ANTHROPIC_API_KEY_FILE=C:\Users\you\Documents\frogbot-key.txt

# OpenAI (used when there is no Claude key): https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_API_KEY_FILE=C:\Users\you\Documents\openai-key.txt

# Only used by the headless server mode (`npm run server`).
# Anyone who knows this token can drive your agents, so make it long and random.
# The server refuses to start while it is still "change-me" or shorter than 16 characters.
FROG_SERVER_TOKEN=change-me
FROG_SERVER_PORT=4777

# Optional: where agents keep their files, memory and logs (default: ~/FrogsWorld)
# FROG_HOME=
