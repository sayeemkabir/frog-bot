# Frog Bot needs exactly one thing from you: a Claude API key.
# Get one at https://console.anthropic.com/settings/keys
#
# You can paste it into the app on first launch (it is then stored encrypted
# with your OS keychain), or put it here as ANTHROPIC_API_KEY and copy this
# file to `.env`. The `.env` file is git-ignored and never committed.
ANTHROPIC_API_KEY=your-claude-api-key-here

# Or keep the key in its own file and point to it:
# ANTHROPIC_API_KEY_FILE=C:\Users\you\Documents\frogbot-key.txt

# Only used by the headless server mode (`npm run server`).
# Anyone who knows this token can drive your agents, so make it long and random.
FROG_SERVER_TOKEN=change-me
FROG_SERVER_PORT=4777

# Optional: where agents keep their files, memory and logs (default: ~/FrogsWorld)
# FROG_HOME=
