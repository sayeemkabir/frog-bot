{
  "workspaceName": "Webshapers Agency",
  "defaultModel": "claude-opus-5-5",
  "models": [
    { "id": "claude-opus-5-5", "label": "Claude Opus 5.5" },
    { "id": "claude-sonnet-5-5", "label": "Claude Sonnet 5.5" },
    { "id": "claude-haiku-5-5", "label": "Claude Haiku 5.5" },
    { "id": "claude-fable-5-1", "label": "Claude Fable 5.1" }
  ],
  "integrations": [
    {
      "id": "ros",
      "name": "ROS Dashboard",
      "description": "RankersFly Reddit operations: projects, accounts, subreddits, post and comment actions.",
      "icon": "🚀",
      "transport": "http",
      "url": "https://dashboard.rankersfly.com/api/mcp",
      "auth": "oauth",
      "builtin": true,
      "autoConnect": true
    },
    {
      "id": "browser",
      "name": "Browser (Chromium)",
      "description": "Each agent drives its own Chrome profile on this computer: open sites, click, type, read pages.",
      "icon": "🌐",
      "transport": "builtin-browser",
      "auth": "none",
      "builtin": true,
      "autoConnect": true
    }
  ],
  "templates": [
    {
      "id": "slack",
      "name": "Slack",
      "description": "Read channels, collect requests, and post on your behalf (always asks first).",
      "icon": "💬",
      "transport": "http",
      "url": "",
      "auth": "oauth",
      "fields": [
        { "key": "url", "label": "Slack MCP server URL", "placeholder": "https://mcp.slack.com/mcp" },
        { "key": "token", "label": "Token (leave empty to sign in with OAuth)", "placeholder": "xoxp-…", "secret": true }
      ]
    },
    {
      "id": "notion",
      "name": "Notion",
      "description": "Search, read and write pages and databases.",
      "icon": "📝",
      "transport": "http",
      "url": "https://mcp.notion.com/mcp",
      "auth": "oauth",
      "fields": [{ "key": "url", "label": "Server URL", "placeholder": "https://mcp.notion.com/mcp" }]
    },
    {
      "id": "github",
      "name": "GitHub",
      "description": "Repos, issues and pull requests.",
      "icon": "🐙",
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "auth": "token",
      "fields": [
        { "key": "url", "label": "Server URL", "placeholder": "https://api.githubcopilot.com/mcp/" },
        { "key": "token", "label": "Personal access token", "placeholder": "github_pat_…", "secret": true }
      ]
    },
    {
      "id": "linear",
      "name": "Linear",
      "description": "Issues, projects and cycles.",
      "icon": "📐",
      "transport": "http",
      "url": "https://mcp.linear.app/mcp",
      "auth": "oauth",
      "fields": [{ "key": "url", "label": "Server URL", "placeholder": "https://mcp.linear.app/mcp" }]
    },
    {
      "id": "custom-http",
      "name": "Custom MCP (HTTP)",
      "description": "Any remote MCP server. Sign in with OAuth, or paste a token.",
      "icon": "🔌",
      "transport": "http",
      "url": "",
      "auth": "oauth",
      "fields": [
        { "key": "name", "label": "Name", "placeholder": "Neeto Desk" },
        { "key": "url", "label": "Server URL", "placeholder": "https://example.com/mcp" },
        { "key": "token", "label": "Token (optional)", "placeholder": "Leave empty to use OAuth", "secret": true }
      ]
    },
    {
      "id": "custom-stdio",
      "name": "Custom MCP (local command)",
      "description": "Run an MCP server as a local program on this computer.",
      "icon": "🖥️",
      "transport": "stdio",
      "auth": "none",
      "fields": [
        { "key": "name", "label": "Name", "placeholder": "My files server" },
        { "key": "command", "label": "Command", "placeholder": "npx" },
        { "key": "args", "label": "Arguments", "placeholder": "-y some-mcp-server --flag" }
      ]
    }
  ]
}
