{
  "workspaceName": "My team",
  "defaultModel": "claude-opus-5-5",
  "models": [
    {
      "id": "claude-opus-5-5",
      "label": "Claude Opus 5.5"
    },
    {
      "id": "claude-sonnet-5-5",
      "label": "Claude Sonnet 5.5"
    },
    {
      "id": "claude-haiku-5-5",
      "label": "Claude Haiku 5.5"
    },
    {
      "id": "claude-fable-5-1",
      "label": "Claude Fable 5.1"
    }
  ],
  "integrations": [
    {
      "id": "browser",
      "name": "Browser (Chromium)",
      "description": "Each agent drives its own Chrome profile on this computer: open sites, click, type, read pages.",
      "icon": "🌐",
      "transport": "builtin-browser",
      "auth": "none",
      "builtin": true,
      "autoConnect": true
    }
  ],
  "templates": [
    {
      "id": "slack",
      "name": "Slack",
      "description": "Read channels, find what people asked for, and post on your behalf.",
      "icon": "💬",
      "transport": "http",
      "url": "https://mcp.slack.com/mcp",
      "auth": "oauth",
      "oauthPort": 3119,
      "scope": "search:read.public search:read.private search:read.mpim search:read.im search:read.files search:read.users channels:history groups:history mpim:history im:history channels:read groups:read im:read mpim:read chat:write reactions:read reactions:write users:read users:read.email files:read canvases:read canvases:write",
      "help": "Slack only lets in apps you own, so you make a small free one, once. It takes about a minute.",
      "fields": [
        {
          "key": "clientId",
          "label": "Client ID (from your Slack app's Basic Information)",
          "placeholder": "1234567890.1234567890123"
        },
        {
          "key": "clientSecret",
          "label": "Client Secret",
          "placeholder": "••••••••",
          "secret": true
        }
      ],
      "manifest": {
        "display_information": {
          "name": "Frog Bot",
          "description": "Lets your Frog Bot agents read, search and (with your OK) post in Slack as you.",
          "background_color": "#0b1a12"
        },
        "oauth_config": {
          "redirect_urls": [
            "http://localhost:3119/oauth/callback"
          ],
          "scopes": {
            "user": [
              "search:read.public",
              "search:read.private",
              "search:read.mpim",
              "search:read.im",
              "search:read.files",
              "search:read.users",
              "channels:history",
              "groups:history",
              "mpim:history",
              "im:history",
              "channels:read",
              "groups:read",
              "im:read",
              "mpim:read",
              "chat:write",
              "reactions:read",
              "reactions:write",
              "users:read",
              "users:read.email",
              "files:read",
              "canvases:read",
              "canvases:write"
            ]
          }
        },
        "settings": {
          "org_deploy_enabled": false,
          "socket_mode_enabled": false,
          "token_rotation_enabled": false
        }
      }
    },
    {
      "id": "notion",
      "name": "Notion",
      "description": "Search, read and write pages and databases.",
      "icon": "📝",
      "transport": "http",
      "url": "https://mcp.notion.com/mcp",
      "auth": "oauth",
      "fields": [
        {
          "key": "url",
          "label": "Server URL",
          "placeholder": "https://mcp.notion.com/mcp"
        }
      ]
    },
    {
      "id": "github",
      "name": "GitHub",
      "description": "Repos, issues and pull requests.",
      "icon": "🐙",
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "auth": "token",
      "fields": [
        {
          "key": "url",
          "label": "Server URL",
          "placeholder": "https://api.githubcopilot.com/mcp/"
        },
        {
          "key": "token",
          "label": "Personal access token",
          "placeholder": "github_pat_…",
          "secret": true
        }
      ]
    },
    {
      "id": "linear",
      "name": "Linear",
      "description": "Issues, projects and cycles.",
      "icon": "📐",
      "transport": "http",
      "url": "https://mcp.linear.app/mcp",
      "auth": "oauth",
      "fields": [
        {
          "key": "url",
          "label": "Server URL",
          "placeholder": "https://mcp.linear.app/mcp"
        }
      ]
    },
    {
      "id": "custom-http",
      "name": "Custom MCP (HTTP)",
      "description": "Any remote MCP server. Sign in with OAuth, or paste a token.",
      "icon": "🔌",
      "transport": "http",
      "url": "",
      "auth": "oauth",
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "placeholder": "Neeto Desk"
        },
        {
          "key": "url",
          "label": "Server URL",
          "placeholder": "https://example.com/mcp"
        },
        {
          "key": "token",
          "label": "Token (optional)",
          "placeholder": "Leave empty to use OAuth",
          "secret": true
        }
      ]
    },
    {
      "id": "custom-stdio",
      "name": "Custom MCP (local command)",
      "description": "Run an MCP server as a local program on this computer.",
      "icon": "🖥️",
      "transport": "stdio",
      "auth": "none",
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "placeholder": "My files server"
        },
        {
          "key": "command",
          "label": "Command",
          "placeholder": "npx"
        },
        {
          "key": "args",
          "label": "Arguments",
          "placeholder": "-y some-mcp-server --flag"
        }
      ]
    }
  ],
  "accounts": {
    "supabaseUrl": "https://rzarqkxpsmbsyzfojfxr.supabase.co",
    "supabaseAnonKey": "sb_publishable_4ppxz4rSsbuZ_HvRtcdWcg_GudHshnI"
  }
}
